# =============================================================================
# Configuração do Bot de Remarketing Telegram
# Copie este arquivo para ".env" e preencha com seus dados.
# =============================================================================

# --- Telegram (obrigatório) ---
# Pegue em https://my.telegram.org -> API development tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Número da sua conta no formato internacional (+5511999999999)
TELEGRAM_PHONE=+5511999999999

# --- Grupos do Telegram ---
# Grupo PRIVADO = onde estão os já convertidos / pagos / dentro do produto.
# Membros desse grupo NUNCA recebem remarketing.
# Use @username (se for público), ou ID negativo tipo -1001234567890.
PRIVATE_GROUP=@meugrupoprivado

# Grupo de leads (opcional). Se você só tem 1 grupo (o privado), deixa vazio.
# Quando vazio, os leads são detectados a partir do histórico de DMs do suporte.
LEADS_SOURCE_GROUP=

# Link de convite do grupo privado (https://t.me/+xxxxx).
# O bot escaneia suas DMs procurando mensagens onde VOCÊ (suporte) enviou esse link.
# Quem recebeu o link → marcado como EXCLUDED (não recebe remarketing).
# ESSENCIAL pra grupos grandes (>200 membros) onde Telegram não lista todos.
PRIVATE_GROUP_INVITE_LINK=https://t.me/+zdaQT6bejPZhODk5

# --- IA (opcional - só pra modo "ai" / geração de texto em espanhol) ---
# Provedor padrão: anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Painel Web ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Senha do painel (deixe em branco pra acesso aberto na sua máquina)
WEB_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# === Liga (TORNEIO MENSAL — opcional) ===
# ═══════════════════════════════════════════════════════════════════════
# A Liga é uma campanha temporária de 1 mês. Quando torneio acabar, set
# ENABLE_LIGA=0 pra desligar TODOS os jobs/handlers/UI relacionados.
# Bot continua funcionando normalmente como remarketing core.
ENABLE_LIGA=1
# Datas do torneio (formato YYYY-MM-DD). Checkpoints são calculados:
# CP1 = start+6d, CP2 = start+13d, CP3 = start+20d, Final = end_date
LIGA_START_DATE=
LIGA_END_DATE=

# --- Robustez (Bloco 2: não cair em produção) ---
# StringSession do Telethon (opcional). Se setado, sobrevive a redeploy
# sem precisar do arquivo userbot.session. Pra exportar: python -c
# "import asyncio; from userbot.client import export_string_session;
# print(asyncio.run(export_string_session()))"
TELETHON_SESSION=

# Telegram ID do admin (você) pra receber heartbeat hora-em-hora
# e notificações de erros. Pra descobrir teu ID: manda /start pra @userinfobot
ADMIN_TELEGRAM_ID=

# Reconnect loop do Telethon — se conexão cair, retenta a cada N segundos
TELETHON_RECONNECT_INTERVAL=30

# Heartbeat — DM hourly pro admin "bot OK" (default DESLIGADO — ocupa privado)
# Pra saber se bot tá vivo: use /diagnostic ou /health no painel
HEARTBEAT_ENABLED=0

# --- Scans automáticos de IA (DESLIGADOS por default — gastam $$) ---
# AUTO_DM_SCAN=1 LIGA 3 jobs que processam imagens com Claude Vision:
#   1. auto_incremental_dm_scan (a cada 5min — pega 30 leads, vê imagens)
#   2. auto_weekly_revalidation (domingo 03h ART)
#   3. auto_validate_pending_ids (a cada 1h, min 30)
# Em modo PASSIVO normal, NÃO precisa disso. Bot só roda Vision quando
# DM nova chega com imagem (no tracker, em tempo real). Esses jobs eram
# pra automação massiva — gastam $5-10/dia desnecessário se não precisar.
AUTO_DM_SCAN=0

# --- Comportamento do bot (PASSIVO por default) ---
# AUTO_RESPOND_FUNNEL=0 → bot apenas CATALOGA DMs e sugere ações.
# Você responde manualmente. Modo recomendado.
# AUTO_RESPOND_FUNNEL=1 → funil VIP automático ativo (responde leads
# sozinho — só ative se realmente quer essa automação).
AUTO_RESPOND_FUNNEL=0

# Vision: fallback Sonnet pra prints onde Haiku falha.
# Default 0 (desligado) — Haiku 4.5 já é vision-capable e acerta o
# suficiente. Sonnet só vira custo extra. Liga só se quiser garantia
# extra em casos raros (custo: ~$0.005 por imagem onde Haiku falhou).
VISION_SONNET_FALLBACK=0

# Buffer de debounce — agrupa DMs consecutivas pra processar como uma só.
# Default 2s. Reduz pra 0 se quiser desligar agregação.
FUNNEL_DEBOUNCE_SECONDS=2
FUNNEL_DEBOUNCE_MAX_WAIT=10

# --- Limites de envio (conta aquecida) ---
# Defaults pensados pra ~1500 forwards/dia em uma conta bem aquecida.
# Se sua conta for mais nova, BAIXE esses valores.
SEND_DELAY_MIN=15
SEND_DELAY_MAX=40
MAX_SENDS_PER_HOUR=120
LONG_PAUSE_EVERY=80
LONG_PAUSE_SECONDS=180

# --- Aba Testes ---
# Seu @username pra testar scripts antes de mandar pros leads.
TEST_USERNAME=braozin

# --- Modo passivo (recomendado durante torneio) ---
# Quando 0 (default), bot só observa e cataloga — você responde tudo manualmente.
# Quando 1, handlers da Liga respondem automaticamente (waiting_id, deposit, etc).
AUTO_REPLY=0

# --- Funil de remarketing — cooldowns entre rodadas ---
# Bot só CATEGORIZA, nunca dispara sozinho. Esses valores controlam quando um lead
# em "rX_sent_cooldown" passa pra "rX_cold" (elegível pra próxima rodada).
COOLDOWN_AFTER_R1_HOURS=24
COOLDOWN_AFTER_R2_DAYS=7
COOLDOWN_AFTER_R3_DAYS=14
DISCARD_AFTER_R3_DAYS=21
# Janela em horas pra considerar lead "fresh" (msg recente — não disparar)
FRESH_WINDOW_HOURS=24

# --- Cálculo de ROI (cost per conversion) ---
# Comissão média por FTD (First Time Deposit) em BRL — afiliado Quotex.
# Mostra ROI como range pessimista (MIN) → otimista (MAX).
AVG_COMMISSION_BRL_MIN=5
AVG_COMMISSION_BRL_MAX=8
# Taxa USD→BRL pra converter custos da Anthropic. Atualize quando o câmbio mudar muito.
USD_BRL_RATE=5.0

# --- Obsidian Vault (cérebro humano-IA colaborativo) ---
# Caminho local da vault. Bot exporta cada lead como .md aqui automaticamente.
# Você abre essa pasta no Obsidian (free) pra ver/anotar tudo.
# Deixe vazio pra desabilitar export.
# Windows: OBSIDIAN_VAULT_PATH=C:\liga-vault
# Linux/VPS: OBSIDIAN_VAULT_PATH=/var/lib/liga-vault (ou vazio)
OBSIDIAN_VAULT_PATH=

# --- Liga (torneio) ---
# Grupo onde o ranking diário é postado (ex: @minhaliga ou -1001234567890).
LIGA_GROUP=
# Seu Telegram ID para receber alertas VIP, relatório semanal e alertas de IA falhada.
# OBRIGATÓRIO durante torneio — sem isso você não recebe alertas críticos.
ADMIN_TELEGRAM_ID=
# Datas do torneio (YYYY-MM-DD). Se vazio, os checkpoints não são agendados.
# Checkpoints calculados automaticamente: start+6d, +13d, +20d (08h00 BA).
# Corte final = LIGA_END_DATE (23h55 BA).
# Datas que já passaram são puladas com warning no log.
LIGA_START_DATE=2026-05-11
LIGA_END_DATE=2026-06-11

# --- Validação de IDs pendentes (anti-spam) ---
# A cada hora min:30, o bot valida IDs extraídos mas não validados via @QuotexPartnerBot.
# Delay entre cada chamada (em segundos) — quanto maior, menos suspeita de spam.
PARTNER_BOT_DELAY_SECONDS=15
# Jitter aleatório (±N segundos) pra parecer humano (anti-padrão de bot).
PARTNER_BOT_DELAY_JITTER=3
# Máximo de validações por execução. Com 30 × 15s = ~8 minutos por run.
MAX_PENDING_VALIDATIONS_PER_RUN=30

# --- Modo vigília torneio ---
# Quando ativo, o bot:
#   - Faz backup a cada 6h (em vez de só 1x/dia)
#   - Manda daily digest 2x/dia (08h e 12h BA)
#   - Notifica admin via DM quando IA falha em ler print (vision_failed)
#   - Detecta imagens duplicadas (anti-fraude)
# Valores:
#   auto   = ativo entre LIGA_START_DATE e LIGA_END_DATE (recomendado)
#   always = ativo sempre (use só se não tem datas configuradas)
#   never  = desativa todos os alertas extras
LIGA_TOURNAMENT_MODE=auto
